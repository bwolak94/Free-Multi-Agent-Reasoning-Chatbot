# =============================================================================
# Free Multi-Agent Reasoning Chatbot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys (all free tiers)
# -----------------------------------------------------------------------------
# Groq — https://console.groq.com → API Keys (free)
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com → Get API key (free)
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai → Keys (free tier with :free models)
OPENROUTER_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens (free account)
HF_TOKEN=

# Tavily search (optional fallback) — https://tavily.com (free tier)
TAVILY_API_KEY=

# Cerebras (optional, for fast inference) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Production: postgresql+asyncpg://user:pass@host:5432/dbname
# Dev (Docker Compose): postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# Set to "true" to use SQLite instead of Postgres (dev only)
USE_SQLITE=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# AWS S3 (artifacts)
# -----------------------------------------------------------------------------
# On EC2: leave empty — IAM instance role is used automatically
# Locally: set these for dev (or set USE_LOCAL_FS=true to skip S3 entirely)
AWS_S3_BUCKET=chatbot-artifacts-your-suffix
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set to "true" to use local filesystem instead of S3 (dev only)
USE_LOCAL_FS=true

# -----------------------------------------------------------------------------
# Observability — Langfuse
# -----------------------------------------------------------------------------
# Self-hosted Langfuse (Docker Compose): http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# API host/port
API_HOST=0.0.0.0
API_PORT=8000

# Worker concurrency
WORKER_CONCURRENCY=2

# Max LangGraph reflection iterations (default: 3)
MAX_ITERATIONS=3

# Artifact TTL in days (default: 7)
ARTIFACT_TTL_DAYS=7

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Environment: development | production
ENVIRONMENT=development

# Secret key for signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production
