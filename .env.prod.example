# =============================================================================
# Free Multi-Agent Reasoning Chatbot — Production Environment Variables
# Hetzner CX32 + Cloudflare R2
#
# Copy this file to .env on the server and fill in all values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server / Domain
# -----------------------------------------------------------------------------
# Your public domain name pointing to the Hetzner Floating IP
DOMAIN=chat.example.com

# GitHub Container Registry repo (for image pull in docker-compose.prod.yml) - MUST be lowercase
GITHUB_REPOSITORY=bwolak94/free-multi-agent-reasoning-chatbot
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# LLM API Keys (all free tiers)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
TAVILY_API_KEY=
CEREBRAS_API_KEY=

# -----------------------------------------------------------------------------
# Database — Postgres (Docker Compose internal)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chatbot:CHANGE_ME@postgres:5432/chatbot

# -----------------------------------------------------------------------------
# Redis (Docker Compose internal)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Cloudflare R2 Artifact Storage
# Get credentials: Cloudflare Dashboard → R2 → Manage R2 API tokens
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chatbot-artifacts
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Set to "false" in production — use R2 not local filesystem
USE_LOCAL_FS=false

# -----------------------------------------------------------------------------
# Observability — Langfuse (self-hosted, Docker Compose internal)
# After first boot: log in at http://your-server:3000, create project → get keys
# -----------------------------------------------------------------------------
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse Postgres auth — change before first boot
NEXTAUTH_SECRET=
SALT=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_ITERATIONS=3
ARTIFACT_TTL_DAYS=7

# Generate with: openssl rand -hex 32
SECRET_KEY=
